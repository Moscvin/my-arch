# i3 config - my-arch
# Mod = tasta Windows (Super)
set $mod Mod4
set $term alacritty

font pango:JetBrainsMono Nerd Font 10

# ---------- autostart
exec_always --no-startup-id ~/.config/i3/monitors.sh
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst
exec --no-startup-id picom -b
exec --no-startup-id nm-applet
exec --no-startup-id copyq
exec --no-startup-id udiskie --tray --automount
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 1e1e2e
exec_always --no-startup-id sh -c '[ -f ~/.config/wallpaper.jpg ] && feh --bg-fill ~/.config/wallpaper.jpg || xsetroot -solid "#1e1e2e"'

# ---------- aplicatii
bindsym $mod+Return exec $term
bindsym $mod+d exec --no-startup-id rofi -show drun -show-icons
bindsym $mod+Tab exec --no-startup-id rofi -show window
bindsym $mod+e exec thunar
bindsym $mod+b exec google-chrome-stable
bindsym $mod+period exec --no-startup-id rofimoji
bindsym $mod+v exec --no-startup-id copyq toggle
bindsym Print exec --no-startup-id flameshot gui
bindsym $mod+Escape exec --no-startup-id i3lock -c 1e1e2e

# ---------- sunet (PipeWire)
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute exec --no-startup-id pamixer -t
bindsym $mod+equal exec --no-startup-id pamixer -i 5
bindsym $mod+minus exec --no-startup-id pamixer -d 5
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ---------- ferestre
floating_modifier $mod
tiling_drag modifier titlebar
default_border pixel 2
gaps inner 6

bindsym $mod+q kill
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+semicolon split h
bindsym $mod+apostrophe split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ---------- workspace-uri: 1-5 pe monitorul principal, 6-10 pe al doilea
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary
workspace $ws5 output primary
workspace $ws6 output nonprimary primary
workspace $ws7 output nonprimary primary
workspace $ws8 output nonprimary primary
workspace $ws9 output nonprimary primary
workspace $ws10 output nonprimary primary

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# muta workspace-ul curent pe celalalt monitor
bindsym $mod+Shift+m move workspace to output next

# ---------- i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Iesi din i3?' -B 'Da, logout' 'i3-msg exit'"

mode "resize" {
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---------- bara (apare pe ambele monitoare, tray doar pe principal)
bar {
        status_command i3status
        position top
        tray_output primary
        colors {
                background #1e1e2e
                statusline #cdd6f4
                focused_workspace  #89b4fa #89b4fa #1e1e2e
                active_workspace   #45475a #45475a #cdd6f4
                inactive_workspace #1e1e2e #1e1e2e #a6adc8
                urgent_workspace   #f38ba8 #f38ba8 #1e1e2e
        }
}

# culori ferestre
client.focused          #89b4fa #89b4fa #1e1e2e #f5c2e7 #89b4fa
client.unfocused        #45475a #1e1e2e #a6adc8 #45475a #45475a
client.focused_inactive #45475a #1e1e2e #cdd6f4 #45475a #45475a
