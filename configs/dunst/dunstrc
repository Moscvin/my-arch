[global]
    monitor = 0
    follow = mouse
    width = 350
    origin = top-right
    offset = (12, 40)
    corner_radius = 6
    font = JetBrainsMono Nerd Font 10
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
